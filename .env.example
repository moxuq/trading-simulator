# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/trading
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/trading

# App
DEBUG=true
APP_NAME=Trading Simulator
API_PREFIX=/api/v1

# JWT
SECRET_KEY=change-me-to-64-random-chars
ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=1440

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Trading
DEFAULT_CASH=1000000
POINT_MULTIPLIER=100
TICK_INTERVAL_SEC=5
MAKER_SPREAD_BPS=50
MAKER_QTY=1000
